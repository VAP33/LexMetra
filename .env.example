# =============================================================================
# LexMetra / LMPC Compliance Platform — Environment Variables
#
# Copy this file to .env and fill in the values before running:
#   cp .env.example .env
#   docker compose up --build
#
# .env is in .gitignore and will NEVER be committed.
# This .env.example file is safe to commit — it contains no real secrets.
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED — Docker Compose will refuse to start without this
# -----------------------------------------------------------------------------

# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-generate-a-real-secret-before-running


# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------

POSTGRES_USER=lmpc_app
POSTGRES_PASSWORD=lmpc_dev_pw
POSTGRES_DB=lmpc

# Host port PostgreSQL is exposed on (for local debugging tools like pgAdmin)
POSTGRES_PORT=5432


# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------

# Host port the FastAPI backend is exposed on
BACKEND_PORT=8000

# JWT settings
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# App mode
# Set LMPC_DEV_MODE=true to relax JWT secret enforcement (dev only)
LMPC_DEV_MODE=false

# Demo mode: creates admin/inspector/reviewer accounts on first start
# Only enable for SIH demo / local development — never in production
LMPC_DEMO_MODE=false
LMPC_BOOTSTRAP_DEMO_USERS=false

# CORS — comma-separated list of allowed frontend origins
# Add your frontend's URL if it runs on a different host/port
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173

# Upload size limit in bytes (default 12 MB)
LMPC_MAX_UPLOAD_BYTES=12582912


# -----------------------------------------------------------------------------
# OCR settings
# -----------------------------------------------------------------------------

LMPC_ENABLE_PADDLEOCR=false
LMPC_OCR_MAX_PASSES=8
LMPC_OCR_MAX_REGIONS=24
LMPC_ENABLE_REGION_FIRST_OCR=true


# -----------------------------------------------------------------------------
# Optional — VLM (Vision Language Model) providers
# Leave blank to disable. Backend works fully without these.
# -----------------------------------------------------------------------------

VLM_VERIFICATION_ENABLED=false
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIza...
