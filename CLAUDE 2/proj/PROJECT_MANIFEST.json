  "database": {
    "technology": "PostgreSQL",
    "driver": "psycopg2-binary",
    "connection_env_var": "DATABASE_URL",
    "hardcoded_fallback_url": "postgresql://lmpc_app:lmpc_dev_pw@localhost:5432/lmpc",
    "credential_in_source": true,
    "auto_init_on_startup": true,
    "tables": [
      {
        "name": "products",
        "columns": [
          "product_id TEXT PK",
          "category TEXT",
          "first_seen_at TIMESTAMPTZ NOT NULL DEFAULT now()"
        ],
        "indexes": [
          "PRIMARY KEY product_id"
        ]
      },
      {
        "name": "inspections",
        "columns": [
          "inspection_id TEXT PK",
          "product_id TEXT FK->products",
          "sale_type TEXT NOT NULL",
          "product_category TEXT NOT NULL",
          "net_quantity_value NUMERIC CHECK >0",
          "net_quantity_unit TEXT",
          "mrp NUMERIC CHECK >=0",
          "overall_status TEXT NOT NULL CHECK IN (PASS,FAIL,UNCERTAIN,EXEMPT)",
          "exempt_reason TEXT",
          "image_filename TEXT",
          "created_at TIMESTAMPTZ NOT NULL DEFAULT now()",
          "reviewed BOOLEAN NOT NULL DEFAULT FALSE",
          "reviewer_note TEXT",
          "review_required BOOLEAN NOT NULL DEFAULT FALSE"
        ],
        "indexes": [
          "idx_inspections_product ON product_id",
          "idx_inspections_status ON overall_status",
          "idx_inspections_created ON created_at DESC",
          "idx_inspections_review PARTIAL WHERE reviewed=FALSE",
          "idx_inspections_needs_review PARTIAL WHERE review_required=TRUE"
        ]
      },
      {
        "name": "inspection_facts",
        "columns": [
          "id SERIAL PK",
          "inspection_id TEXT NOT NULL FK->inspections ON DELETE CASCADE",
          "field TEXT NOT NULL",
          "extracted_value TEXT",
          "status TEXT NOT NULL CHECK IN (PASS,FAIL,UNCERTAIN,EXEMPT)",
          "confidence NUMERIC CHECK 0<=confidence<=1",
          "rule_id TEXT",
          "rule_version TEXT",
          "reason TEXT",
          "review_required BOOLEAN NOT NULL DEFAULT FALSE",
          "evidence_json JSONB"
        ],
        "indexes": [
          "idx_facts_inspection ON inspection_id",
          "idx_facts_field ON field",
          "idx_facts_status ON status",
          "idx_facts_rule ON rule_id",
          "idx_facts_review PARTIAL WHERE review_required=TRUE"
        ]
      }
    ]
  },
