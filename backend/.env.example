# Local SIH demo / development settings
LMPC_DEV_MODE=true
LMPC_DEMO_MODE=true
LMPC_BOOTSTRAP_DEMO_USERS=true
JWT_SECRET_KEY=change-me-for-local-use

# Services
DATABASE_URL=postgresql://lmpc_app:lmpc_dev_pw@localhost:5432/lmpc
REDIS_URL=redis://localhost:6379/0

# Frontend / HTTP
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5500
LMPC_MAX_UPLOAD_BYTES=12582912

# OCR / VLM
LMPC_ENABLE_PADDLEOCR=false
VLM_VERIFICATION_ENABLED=false
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
