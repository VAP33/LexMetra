# Copy this file to `.env` in the backend/ directory for local development.
# Never commit a real .env file. It is already listed in .gitignore.

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://lmpc_app:lmpc_dev_pw@localhost:5432/lmpc

# --- Authentication ----------------------------------------------------------
# Generate a real secret for anything beyond local development, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Set to false for any non-local deployment. When false, the API refuses to
# start unless JWT_SECRET_KEY is explicitly set.
LMPC_DEV_MODE=true

# --- CORS --------------------------------------------------------------------
# Comma-separated list of allowed browser origins. Do NOT use "*" once
# authentication is enabled.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5500

# --- Storage -------------------------------------------------------------------
UPLOAD_DIR=./uploads
REPORT_DIR=./reports

# --- Optional: VLM ambiguous-field verification (advisory only, never the
# final legal decision) ------------------------------------------------------
ANTHROPIC_API_KEY=
VLM_VERIFICATION_ENABLED=false

# Explicitly opt in to predictable demo accounts for local development only.
LMPC_BOOTSTRAP_DEMO_USERS=false

# Operational cache only; never authoritative for legal rules.
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300
